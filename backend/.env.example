# ============================================================
# AI Trading App - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----------------------------------------------------------
# Binance Exchange
# Get keys at: https://www.binance.com/en/my/settings/api-management
# ----------------------------------------------------------
BINANCE_API_KEY=
BINANCE_SECRET=
# Set to "true" to use Binance testnet instead of live
BINANCE_TESTNET=false

# ----------------------------------------------------------
# Bybit Exchange
# Get keys at: https://www.bybit.com/app/user/api-management
# ----------------------------------------------------------
BYBIT_API_KEY=
BYBIT_SECRET=
# Options: mainnet, testnet
BYBIT_NETWORK=mainnet

# ----------------------------------------------------------
# OANDA (Forex)
# Get keys at: https://www.oanda.com/account/tpa/personal_token
# ----------------------------------------------------------
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# Options: live, practice
OANDA_ENVIRONMENT=practice

# ----------------------------------------------------------
# Alpaca (US Stocks)
# Get keys at: https://alpaca.markets/
# ----------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET=
# Set to "true" to use Alpaca paper trading
ALPACA_PAPER=true

# ----------------------------------------------------------
# Anthropic (Claude AI)
# Get key at: https://console.anthropic.com/
# ----------------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------------
# Database
# Default uses local SQLite (no setup required)
# For PostgreSQL: postgresql+asyncpg://user:password@host/dbname
# ----------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./trading.db

# ----------------------------------------------------------
# Redis (optional - used for caching and pub/sub)
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------
# Security
# Generate with: openssl rand -hex 32
# ----------------------------------------------------------
SECRET_KEY=change-me-generate-a-secure-random-key

# ----------------------------------------------------------
# App Settings
# ----------------------------------------------------------
# Allowed CORS origins (comma-separated). Use * for all.
CORS_ORIGINS=*
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Port the app listens on
PORT=8000
