# ============================================================
# SHOPIFY CREDENTIALS
# Get these from your Shopify Admin > Apps > Develop apps
# ============================================================
SHOPIFY_STORE_URL=your-store-name.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# ============================================================
# AI PROVIDER (choose ONE and fill in that section)
# Free options: Groq (fastest free), OpenRouter (most models)
# Completely free: Ollama (runs locally on your computer)
# ============================================================
AI_PROVIDER=groq

# --- GROQ (Free tier: https://console.groq.com) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-8b-8192

# --- OPENROUTER (Free tier: https://openrouter.ai) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# --- OLLAMA (Completely free, runs locally: https://ollama.ai) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- ANTHROPIC CLAUDE (Paid: https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============================================================
# IMAGE GENERATION (Free options)
# Pollinations.ai is 100% free, no API key needed!
# ============================================================
IMAGE_PROVIDER=pollinations
# If you want to use Replicate (has free credits):
REPLICATE_API_KEY=r8_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# SOCIAL MEDIA (Optional - only fill what you use)
# ============================================================

# Facebook / Instagram (Meta)
# Get from: https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_PAGE_ID=

# TikTok
# Get from: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Pinterest
# Get from: https://developers.pinterest.com
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# ============================================================
# SERVER SETTINGS
# ============================================================
PORT=3000
NODE_ENV=development

# VIP order threshold (orders above this amount trigger VIP message)
VIP_ORDER_THRESHOLD=100

# ============================================================
# ORDER TRIGGER SETTINGS
# ============================================================
ENABLE_ORDER_TRIGGERS=true
ENABLE_VIP_TRIGGERS=true
ENABLE_LOYALTY_TRIGGERS=true
